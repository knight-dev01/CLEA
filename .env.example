# Copy to .env (local) and set the same vars in Vercel Dashboard → Settings → Environment Variables
# POSTGRES_URL comes from Vercel Dashboard → Storage → Postgres → .env.local (Quickstart)
POSTGRES_URL=postgresql://user:password@host/db?sslmode=require
ADMIN_PASSWORD=clea-admin
ADMIN_SECRET=change-me-to-a-long-random-string
